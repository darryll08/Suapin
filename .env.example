# Salin ke .env.local lalu isi. Jangan commit nilai kunci (repo publik).
# Lokal: file:local.db. Online (bonus): libsql://<nama>.turso.io
DATABASE_URL=
TURSO_AUTH_TOKEN=
OPENAI_API_KEY=
# Kosong = gpt-6-luna
OPENAI_MODEL=
# String acak minimal 32 karakter untuk tanda tangan cookie (wajib)
SESI_RAHASIA=
# 1 = aktifkan /api/demo/* (masuk persona, reset data)
DEMO=
# Kata sandi semua akun demo (keluarga@demo.test, dokter@demo.test, klinik@demo.test), maksimal 72 byte (wajib untuk seed)
DEMO_DOKTER_SANDI=
# Akun admin (operator Suapin yang mendaftarkan klinik dan dokter). Kosong = login admin mati.
# Email kosong = admin@demo.test
ADMIN_EMAIL=
ADMIN_SANDI=
# Web Push: buat dengan `npx web-push generate-vapid-keys`. Kosong = notifikasi hanya di dalam app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# 1 = panggil() membalas dari bersama/kontrak/contoh/ tanpa server
VITE_PAKAI_CONTOH=
