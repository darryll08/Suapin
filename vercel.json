{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/((?!api/|assets/|aset/|klip/|mediapipe/|.*\\.[a-z0-9]+$).*)", "destination": "/index.html" }
  ]
}
